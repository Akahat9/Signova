{
  "name": "signova-frontend",
  "version": "0.1.0",
  "private": true,
  "homepage": "/",
  "main": "electron/main.cjs",
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^12.14.0",
    "framer-motion": "^12.40.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.178.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:e2e": "cross-env REACT_APP_SIGNOVA_UI_TEST_MODE=true REACT_APP_SIGNOVA_FIREBASE_EMULATORS=true REACT_APP_FIREBASE_API_KEY=fake-api-key REACT_APP_FIREBASE_AUTH_DOMAIN=localhost REACT_APP_FIREBASE_PROJECT_ID=signova-6e929 REACT_APP_FIREBASE_STORAGE_BUCKET=signova-6e929.appspot.com REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789 REACT_APP_FIREBASE_APP_ID=1:123456789:web:e2etest react-scripts build",
    "test:ci": "react-scripts test --watchAll=false",
    "test:e2e": "node scripts/checkE2EPreflight.js && playwright test",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project signova-6e929 --only firestore,storage \"node --test firebase-rules.test.cjs\"",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"npm start\" \"wait-on http://127.0.0.1:3000 && cross-env ELECTRON_START_URL=http://127.0.0.1:3000 electron .\"",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": ["e2e/**"],
        "rules": {
          "testing-library/prefer-screen-queries": "off",
          "jest/valid-expect": "off",
          "jest/no-conditional-expect": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^36.9.5",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.15",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.19",
    "wait-on": "^8.0.3"
  }
}

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function verifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function safeImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function safeMedia() {
      return request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('(video|audio)/(mp4|mpeg|webm|ogg|wav)');
    }

    function safeChatAttachment() {
      return request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp|gif)|audio/(mpeg|mp4|wav|webm|ogg)|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.ms-powerpoint|application/vnd.openxmlformats-officedocument.presentationml.presentation|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|text/plain)');
    }

    function isChatMember(chatId) {
      return verifiedUser()
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberIds;
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if true;
      allow create, update: if verifiedUser()
        && request.auth.uid == userId
        && safeImage();
      allow delete: if verifiedUser() && request.auth.uid == userId;
    }

    match /users/{userId}/private/{fileName} {
      allow read: if verifiedUser() && request.auth.uid == userId;
      allow create, update: if verifiedUser()
        && request.auth.uid == userId
        && (safeImage() || safeMedia());
      allow delete: if verifiedUser() && request.auth.uid == userId;
    }

    match /community/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if verifiedUser()
        && request.auth.uid == userId
        && (safeImage() || safeMedia());
      allow delete: if verifiedUser() && request.auth.uid == userId;
    }

    match /chatAttachments/{chatId}/{senderId}/{messageId}/{fileName} {
      allow read: if isChatMember(chatId);
      allow create: if isChatMember(chatId)
        && request.auth.uid == senderId
        && messageId.matches('^[A-Za-z0-9._-]{1,128}$')
        && fileName.matches('^[A-Za-z0-9._-]{1,160}$')
        && safeChatAttachment()
        && request.resource.metadata.chatId == chatId
        && request.resource.metadata.senderUid == senderId
        && request.resource.metadata.messageId == messageId;
      allow update: if false;
      allow delete: if isChatMember(chatId) && request.auth.uid == senderId;
    }

    match /encryptedChatAttachments/{chatId}/{senderId}/{attachmentFile} {
      allow read: if isChatMember(chatId);
      allow create: if isChatMember(chatId)
        && request.auth.uid == senderId
        && attachmentFile.matches('^[A-Za-z0-9._-]{1,128}\\.bin$')
        && request.resource.size > 16
        && request.resource.size <= (25 * 1024 * 1024 + 16)
        && request.resource.contentType == 'application/octet-stream'
        && request.resource.metadata.encryptionVersion == '1'
        && request.resource.metadata.chatId == chatId
        && request.resource.metadata.senderUid == senderId;
      allow update: if false;
      allow delete: if isChatMember(chatId) && request.auth.uid == senderId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
